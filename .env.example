# Copy to .env and fill in. .env is never committed.
ANTHROPIC_API_KEY=
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
# Where traces are grouped in LangSmith (project-based workspaces).
LANGSMITH_PROJECT=release-gate-triage
# Small, cheap model. Change it here, not in the code. The reported results
# used these two names, which are not pinned to a dated version.
TRIAGE_MODEL=claude-haiku-5-5
# The model that judges conclusions in evaluation. Stronger than, and
# different from, the model being judged.
JUDGE_MODEL=claude-sonnet-5-5
